# =============================================================================
# mcp-devtools — Example Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your local values.
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# ----- Logging -----
# Set to "true" to enable verbose JSON logs to stderr (default: false)
DEBUG=false

# Log level: "trace" | "debug" | "info" | "warn" | "error" (default: "info")
LOG_LEVEL=info

# ----- Transport -----
# "stdio" (default, used by Claude Desktop / Cursor) | "http"
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http
MCP_HTTP_PORT=3333

# ----- Database connection strings -----
# Referenced from mcp-devtools.json as "env:DATABASE_URL"
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# MYSQL_URL=mysql://user:password@localhost:3306/mydb
# SQLITE_PATH=./data/local.sqlite

# ----- Optional overrides -----
# Override scope root (defaults to cwd of the process)
# MCP_DEVTOOLS_SCOPE=./

# Override config file path (defaults to cosmiconfig search)
# MCP_DEVTOOLS_CONFIG=./mcp-devtools.json
